# ============================================================
# VDT-MT 配置样例（复制为 .env 后按需修改；切勿提交真实密钥）
# ============================================================

# 基础
APP_NAME=vdt-mt
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# 存储（开发/测试默认 SQLite；生产用 PostgreSQL）
DATABASE_URL=sqlite:///./vdtmt.db
DATABASE_ECHO=false
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 可选 Elasticsearch 术语检索（小规模可关闭，用 PG trigram 检索）
# 注意：当前版本尚未实现 ES 检索能力，开启 USE_ELASTICSEARCH=true 将导致
# /api/v1/terms/search 直接返回 501 错误（fail-loud），请保持 false 使用默认 DB 检索。
USE_ELASTICSEARCH=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=vdt_terms

# 翻译器后端：mock(离线默认) / vllm / api
TRANSLATOR_BACKEND=mock
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen2.5-7B
API_BASE_URL=
API_MODEL_NAME=
API_KEY=
API_TIMEOUT_SECONDS=60

# 基座模型 / 微调产物（仅 M3 训练需要，本地运行留空）
BASE_MODEL_NAME=Qwen2.5-7B
LORA_ADAPTER_PATH=
HF_CACHE_DIR=./models

# 质量评估
COMET_ENABLED=false
COMET_MODEL=Unbabel/wmt22-cometkiwi-da
TERM_HIT_WEIGHT=0.5
COMET_WEIGHT=0.5

# 术语注入
TERM_INJECTION_ENABLED=true
MAX_TERMS_PER_REQUEST=200
LOW_CONFIDENCE_THRESHOLD=0.6

# 质量风险规则引擎阈值
RISK_COMET_LOW=0.75
RISK_TERM_MISS_RATE_HIGH=0.20
RISK_DOMAIN_DRIFT_RATE=0.30

# 调度与监控
SCHEDULER_ENABLED=true
METRICS_ENABLED=true
METRICS_PORT=9090

# 安全
API_CORS_ORIGINS=*
API_RATE_LIMIT_PER_MIN=120
